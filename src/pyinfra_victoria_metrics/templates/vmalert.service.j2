[Unit]
Description=VictoriaMetrics Alert service
After=network.target

[Service]
Type=simple
User={{ vmalert_system_user }}
Group={{ vmalert_system_group }}
ExecStart=/usr/local/bin/vmalert {% for flag, flag_value in vmalert_service_args.items() %}-{{ flag }}={{ flag_value }} {% endfor %}

SyslogIdentifier=vmalert
Restart=always

PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes

ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
