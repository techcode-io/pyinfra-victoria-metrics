[Unit]
Description=VictoriaMetrics service
After=network.target

[Service]
Type=simple
LimitNOFILE={{ victoria_metrics_max_open_files }}
User={{ victoria_metrics_system_user }}
Group={{ victoria_metrics_system_group }}
ExecStart=/usr/local/bin/victoria-metrics {% for flag, flag_value in victoria_metrics_service_args.items() %}-{{ flag }}={{ flag_value }} {% endfor %}

SyslogIdentifier=victoria-metrics
Restart=always

PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes

ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
